{
  "model": "claude-sonnet-4-20250514",
  "thinking": {
    "budget_tokens": 10000
  },
  "showThinkingSummaries": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Create",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"$f = '$CLAUDE_TOOL_INPUT_FILE_PATH'; if ($f -match '(appsettings\\.Production|secrets\\.json|\\.pfx|\\.snk)') { Write-Error 'Blocked: production config write'; exit 1 }\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write.*\\.cs$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"if (Get-Command dotnet -ErrorAction SilentlyContinue) { dotnet format MWC.sln --include '$CLAUDE_TOOL_INPUT_FILE_PATH' 2>$null }\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet*)",
      "Bash(git*)",
      "Bash(wix*)",
      "Write(src/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(installer/**)",
      "Write(.github/**)"
    ],
    "deny": [
      "Write(appsettings.Production*)",
      "Write(*.pfx)",
      "Write(*.snk)",
      "Write(secrets.json)",
      "Bash(rm -rf /)",
      "Bash(*netsh*)"
    ]
  },
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  }
}
