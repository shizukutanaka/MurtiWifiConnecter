<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ビルド専用 (Directory.Build.props が全プロジェクトへ注入) -->
    <!-- 8.0.0 は推移的依存 Microsoft.Build.Tasks.Git 8.0.0 に GHSA-23fw-v26w-5fgq
         (CVE-2026-62900, Moderate) があり、8.0.0 系に修正済み NuGet 版は存在しない
         (アドバイザリ明記)。修正済み帯域は 10.0.111 以降のため、SourceLink ごと
         10.0.111 へ上げる (Build.Tasks.Git も 10.0.111 に解決される)。 -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub"     Version="10.0.111" />

    <!-- Core -->
    <PackageVersion Include="CommunityToolkit.Mvvm"          Version="8.4.0" />

    <!-- Hosting / Logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting"   Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging"   Version="9.0.0" />
    <!-- AddSimpleConsole は Logging 本体でなく Console プロバイダ側の API -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />

    <!-- net9.0 (plain) では Microsoft.Win32.Registry が in-box でないため明示参照 -->
    <PackageVersion Include="System.Text.Json"              Version="9.0.0" />
    <PackageVersion Include="Microsoft.Win32.Registry"      Version="5.0.0" />
    <PackageVersion Include="Serilog"                        Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting"     Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.File"             Version="6.0.0" />

    <!-- Platform -->
    <PackageVersion Include="ManagedNativeWifi"              Version="3.0.2" />
    <!-- DPAPI (ProtectedData) は net9.0-windows でも in-box でないため明示参照 -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />

    <!-- QR コード -->
    <PackageVersion Include="QRCoder"                        Version="1.6.0" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine"             Version="2.0.0-beta4.22272.1" />

    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"         Version="17.12.0" />
    <PackageVersion Include="xunit"                          Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio"      Version="2.8.2" />
    <PackageVersion Include="FluentAssertions"               Version="7.0.0" />
    <PackageVersion Include="coverlet.collector"             Version="6.0.2" />
      <PackageVersion Include="FsCheck.Xunit" Version="3.1.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
</Project>
