<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>MurtiWifi Connecter GUI</AssemblyTitle>
    <AssemblyDescription>Graphical User Interface for MurtiWifi Connecter</AssemblyDescription>
    <AssemblyCompany>MurtiSoft</AssemblyCompany>
    <AssemblyProduct>MurtiWifiConnecter.GUI</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2025 MurtiSoft. All rights reserved.</AssemblyCopyright>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <ProductVersion>3.0.0</ProductVersion>
    <StartupObject>MurtiWifiConnecter.GUI.App</StartupObject>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MurtiWifiConnecter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="GUI\DashboardPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="ControlzEx" Version="5.0.2" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="4.11.0" />
  </ItemGroup>

</Project>
