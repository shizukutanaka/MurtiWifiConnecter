{
  "version": "2.0.0",
  "created": "2025-09-14",
  "description": "MurtiWiFiConnecter 家族向けプロファイルテンプレート",
  
  "profiles": {
    "parent": {
      "name": "保護者",
      "description": "保護者向けの完全機能プロファイル",
      "permissions": {
        "manageSettings": true,
        "viewAllDevices": true,
        "controlChildAccess": true,
        "viewUsageStats": true,
        "manageTimeRestrictions": true,
        "manageTrustedNetworks": true
      },
      "settings": {
        "autoConnect": true,
        "showAdvancedOptions": true,
        "enableNotifications": true,
        "batteryOptimization": "Normal"
      },
      "restrictions": {
        "none": true
      }
    },
    
    "teen": {
      "name": "中高生",
      "description": "中高生向けの制限付きプロファイル",
      "ageRange": "13-18",
      "permissions": {
        "manageSettings": false,
        "viewAllDevices": false,
        "controlChildAccess": false,
        "viewUsageStats": false,
        "manageTimeRestrictions": false,
        "manageTrustedNetworks": false
      },
      "settings": {
        "autoConnect": true,
        "showAdvancedOptions": false,
        "enableNotifications": true,
        "batteryOptimization": "Normal"
      },
      "restrictions": {
        "timeRestrictions": {
          "enabled": true,
          "school_days": {
            "startTime": "06:00",
            "endTime": "22:00",
            "maxUsageHours": 6
          },
          "weekends": {
            "startTime": "07:00",
            "endTime": "23:00",
            "maxUsageHours": 8
          }
        },
        "contentFilter": {
          "enabled": true,
          "blockAdultContent": true,
          "blockSocialMedia": false,
          "blockGaming": false,
          "allowedSites": [],
          "blockedSites": []
        },
        "networkAccess": {
          "trustOnlyHomeNetwork": false,
          "blockPublicWiFi": false,
          "requireParentalApproval": true
        }
      }
    },
    
    "child": {
      "name": "小学生",
      "description": "小学生向けの安全重視プロファイル",
      "ageRange": "6-12",
      "permissions": {
        "manageSettings": false,
        "viewAllDevices": false,
        "controlChildAccess": false,
        "viewUsageStats": false,
        "manageTimeRestrictions": false,
        "manageTrustedNetworks": false
      },
      "settings": {
        "autoConnect": true,
        "showAdvancedOptions": false,
        "enableNotifications": false,
        "batteryOptimization": "PowerSaver"
      },
      "restrictions": {
        "timeRestrictions": {
          "enabled": true,
          "school_days": {
            "startTime": "16:00",
            "endTime": "20:00",
            "maxUsageHours": 2
          },
          "weekends": {
            "startTime": "09:00",
            "endTime": "20:00",
            "maxUsageHours": 4
          }
        },
        "contentFilter": {
          "enabled": true,
          "blockAdultContent": true,
          "blockSocialMedia": true,
          "blockGaming": true,
          "whitelistOnly": true,
          "allowedSites": [
            "www.nhk.or.jp",
            "kids.yahoo.co.jp",
            "www.pokemon.co.jp",
            "www.scratch.mit.edu"
          ],
          "blockedCategories": [
            "adult",
            "violence",
            "drugs",
            "gambling",
            "social_networking"
          ]
        },
        "networkAccess": {
          "trustOnlyHomeNetwork": true,
          "blockPublicWiFi": true,
          "requireParentalApproval": true,
          "allowedNetworks": ["HOME_NETWORK"]
        }
      }
    },
    
    "guest": {
      "name": "ゲスト",
      "description": "来客向けの制限付きプロファイル",
      "permissions": {
        "manageSettings": false,
        "viewAllDevices": false,
        "controlChildAccess": false,
        "viewUsageStats": false,
        "manageTimeRestrictions": false,
        "manageTrustedNetworks": false
      },
      "settings": {
        "autoConnect": false,
        "showAdvancedOptions": false,
        "enableNotifications": false,
        "batteryOptimization": "Normal"
      },
      "restrictions": {
        "timeRestrictions": {
          "enabled": true,
          "dailyLimit": {
            "maxUsageHours": 4,
            "startTime": "08:00",
            "endTime": "22:00"
          }
        },
        "contentFilter": {
          "enabled": true,
          "blockAdultContent": true,
          "blockSocialMedia": false,
          "blockGaming": false
        },
        "networkAccess": {
          "trustOnlyHomeNetwork": false,
          "blockPublicWiFi": false,
          "allowedNetworks": ["GUEST_NETWORK"],
          "bandwidthLimit": "10Mbps"
        }
      }
    }
  },
  
  "templates": {
    "restrictive": {
      "name": "制限厳格",
      "description": "最も制限の厳しい安全重視テンプレート",
      "features": {
        "whitelistOnly": true,
        "parentalApprovalRequired": true,
        "timeRestrictionsStrict": true,
        "contentFilterMax": true
      }
    },
    
    "balanced": {
      "name": "バランス型",
      "description": "安全性と利便性のバランステンプレート",
      "features": {
        "moderateRestrictions": true,
        "ageAppropriateContent": true,
        "reasonableTimeLimit": true,
        "parentalOversight": true
      }
    },
    
    "permissive": {
      "name": "自由度重視",
      "description": "最小限の制限で自由度を重視",
      "features": {
        "minimalRestrictions": true,
        "basicSafetyOnly": true,
        "extendedTimeAllowance": true,
        "trustBasedAccess": true
      }
    }
  },
  
  "defaultSettings": {
    "emergencyOverride": {
      "enabled": true,
      "parentPassword": "required",
      "duration": "30minutes"
    },
    
    "notifications": {
      "parentNotifications": {
        "timeRestrictionReached": true,
        "blockedContentAccess": true,
        "newNetworkConnection": true,
        "profileViolation": true
      },
      "childNotifications": {
        "timeWarning": true,
        "contentBlocked": false,
        "connectionSuccess": true
      }
    },
    
    "reporting": {
      "weeklyUsageReport": true,
      "securityIncidentReport": true,
      "networkAccessReport": true,
      "reportDelivery": "email"
    }
  },
  
  "ageGuides": {
    "preschool": {
      "ageRange": "3-5",
      "recommendation": "supervised",
      "maxDailyTime": "30minutes",
      "contentTypes": ["educational", "cartoons"]
    },
    
    "elementary": {
      "ageRange": "6-12",
      "recommendation": "child",
      "maxDailyTime": "2hours",
      "contentTypes": ["educational", "games", "videos"]
    },
    
    "middleSchool": {
      "ageRange": "13-15",
      "recommendation": "teen",
      "maxDailyTime": "4hours",
      "contentTypes": ["educational", "social", "entertainment"]
    },
    
    "highSchool": {
      "ageRange": "16-18",
      "recommendation": "balanced",
      "maxDailyTime": "6hours",
      "contentTypes": ["educational", "social", "entertainment", "productivity"]
    }
  }
}