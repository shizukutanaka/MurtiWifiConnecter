<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net9.0 専用 (Core と同様、netstandard2.0 では net6+ API によりビルド不能)。 -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MWC.SDK</RootNamespace>
    <AssemblyName>MWC.SDK</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet パッケージ設定 -->
    <IsPackable>true</IsPackable>
    <PackageId>MWC.SDK</PackageId>
    <Version>3.12.0</Version>
    <Authors>ShizukuTanaka</Authors>
    <Company>ShizukuTanaka</Company>
    <Description>
      MWC SDK — Lightweight Wi-Fi management library for .NET 9.
      Minimal first-party dependencies. Includes WifiUri, ProfileXmlBuilder,
      CatImportService, RegulatoryDomainService, OweSelectionService,
      Hotspot20Service, and more.
    </Description>
    <PackageTags>wifi;wireless;wpa3;enterprise;eap;hotspot2;eduroam;passpoint;wifiuri;802.11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shizukutanaka/MurtiWifiConnecter</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/shizukutanaka/MurtiWifiConnecter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See CHANGELOG.md for release notes. v3.12.0: wired several previously-orphaned services into the product (VPN/EAP advisories, OWE selection, regulatory-domain display, auto-retry), fixed theme-bypassing colors and silently-swallowed exceptions across the app and CLI, added a WPA3 SSID-binding security advisory.</PackageReleaseNotes>

    <!-- シンボルパッケージ -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- 決定論的ビルド -->
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- SDK は Core のソースをそのまま再パッケージするため、Core と同じ依存を参照する。 -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Win32.Registry" />
  </ItemGroup>

  <!-- README -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Core のソースを直接参照 -->
  <ItemGroup>
    <Compile Include="../src/MWC.Core/**/*.cs" Exclude="../src/MWC.Core/obj/**" />
  </ItemGroup>
</Project>
