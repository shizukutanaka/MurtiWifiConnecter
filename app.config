<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="appSettings" type="System.Configuration.AppSettingsSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" restartOnExternalChanges="false" requirePermission="false" />
    </configSections>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.4" />
            </dependentAssembly>
        </assemblyBinding>

        <!-- ガベージコレクション最適化 -->
        <gcServer enabled="true" />
        <gcConcurrent enabled="true" />
        <gcAllowVeryLargeObjects enabled="false" />
    </runtime>

    <appSettings>
        <!-- アプリケーション設定 -->
        <add key="ApplicationName" value="MurtiWifiConnecter" />
        <add key="Version" value="2.0.0" />
        <add key="Environment" value="Production" />

        <!-- パフォーマンス設定 -->
        <add key="MaxConcurrentConnections" value="10" />
        <add key="ConnectionTimeoutSeconds" value="30" />
        <add key="ScanIntervalSeconds" value="5" />

        <!-- バッテリー最適化 -->
        <add key="EnableBatteryOptimization" value="true" />
        <add key="BatteryLowThreshold" value="20" />
        <add key="BatteryCriticalThreshold" value="10" />

        <!-- セキュリティ設定 -->
        <add key="EnableSecurityValidation" value="true" />
        <add key="WarnOnOpenNetworks" value="true" />
        <add key="BlockSuspiciousNetworks" value="true" />
        <add key="MinimumPasswordLength" value="8" />

        <!-- ログ設定 -->
        <add key="LogLevel" value="Info" />
        <add key="MaxLogFiles" value="7" />
        <add key="MaxLogSizeMB" value="10" />
        <add key="EnableFileLogging" value="true" />

        <!-- UI設定 -->
        <add key="Theme" value="Light" />
        <add key="Language" value="ja-JP" />
        <add key="ShowAdvancedOptions" value="false" />
        <add key="EnableAnimations" value="true" />

        <!-- 通知設定 -->
        <add key="ShowNotifications" value="true" />
        <add key="NotificationDurationMs" value="5000" />
        <add key="NotificationPosition" value="BottomRight" />

        <!-- 家族モード設定 -->
        <add key="FamilyModeEnabled" value="false" />
        <add key="ContentFilterEnabled" value="false" />
        <add key="SafeSearchEnabled" value="false" />
        <add key="TimeRestrictionsEnabled" value="false" />

        <!-- システム設定 -->
        <add key="AutoStart" value="true" />
        <add key="MinimizeToTray" value="true" />
        <add key="StartMinimized" value="false" />
        <add key="ExitOnClose" value="false" />

        <!-- 高度な設定 -->
        <add key="DiagnosticMode" value="false" />
        <add key="VerboseLogging" value="false" />
        <add key="TelemetryEnabled" value="false" />
        <add key="AutoUpdateCheck" value="true" />
        <add key="ExperimentalFeatures" value="false" />

        <!-- ネットワーク設定 -->
        <add key="Prefer5GHz" value="false" />
        <add key="Avoid5GHzOnBattery" value="true" />
        <add key="PreferStrongerSignal" value="true" />
        <add key="NetworkCacheTTLSeconds" value="120" />
    </appSettings>

    <system.diagnostics>
        <trace autoflush="true">
            <listeners>
                <add name="textWriterTraceListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="MurtiWifiConnecter.log" />
            </listeners>
        </trace>
    </system.diagnostics>

    <system.net>
        <settings>
            <httpWebRequest useUnsafeHeaderParsing="false" />
        </settings>
    </system.net>
</configuration>