<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nord (Arctic Ice Studio) パレット。全ブラシキーを完備。 -->

    <SolidColorBrush x:Key="BgBrush"           Color="#2E3440"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#3B4252"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#434C5E"/>
    <SolidColorBrush x:Key="SurfaceSelBrush"   Color="#4C566A"/>

    <SolidColorBrush x:Key="FgBrush"           Color="#ECEFF4"/>
    <SolidColorBrush x:Key="FgMutedBrush"      Color="#D8DEE9"/>
    <SolidColorBrush x:Key="FgVeryMutedBrush"  Color="#7B8494"/>
    <SolidColorBrush x:Key="DividerBrush"      Color="#434C5E"/>

    <SolidColorBrush x:Key="AccentBrush"       Color="#88C0D0"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#8FBCBB"/>
    <SolidColorBrush x:Key="AccentTextBrush"   Color="#2E3440"/>
    <SolidColorBrush x:Key="FocusBrush"        Color="#88C0D0"/>

    <SolidColorBrush x:Key="SuccessBrush"      Color="#A3BE8C"/>
    <SolidColorBrush x:Key="WarnBrush"         Color="#EBCB8B"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="#BF616A"/>
    <!-- #ECEFF4 (Nord "snow storm") はコントラスト比 3.55:1 で WCAG AA (4.5) 未達だった
         (2026-07 監査で発覚)。黒はコントラスト比 5.13:1 で AA を満たす。 -->
    <SolidColorBrush x:Key="DangerTextBrush"   Color="#000000"/>

</ResourceDictionary>
