<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        .NET 9 WPF 公式 Fluent テーマ統合レイヤー
        参照: https://learn.microsoft.com/dotnet/desktop/wpf/whats-new/net90

        使用方法:
          App.xaml で ThemeMode="System" を設定するか、
          Fluent.xaml を MergedDictionaries に追加することで
          Windows 11 の Fluent Design (Light/Dark/System) に自動追従する。

        MWC 固有のブラシは Fluent システムカラーに基づいて定義し、
        Dark.xaml / Light.xaml よりもシステムとの整合性を高める。
    -->

    <!-- MWC アクセントカラー #00C4CC をシステムアクセントにフォールバック付きで定義 -->
    <SolidColorBrush x:Key="AccentBrush"     Color="#00C4CC"/>
    <SolidColorBrush x:Key="AccentHoverBrush"Color="#33D2D9"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#001518"/>

    <!-- セマンティックカラー (Fluent Design に合わせた値) -->
    <SolidColorBrush x:Key="SuccessBrush"    Color="#107C10"/>
    <SolidColorBrush x:Key="WarnBrush"       Color="#C19C00"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#C42B1C"/>
    <SolidColorBrush x:Key="FocusBrush"      Color="#00C4CC"/>

    <!--
        背景・前景は .NET 9 の ThemeMode が管理するため、
        Fluent テーマ使用時は BgBrush / FgBrush 等をシステムリソースから取得。
        フォールバックとして Dark.xaml 相当の値を定義。
    -->
    <SolidColorBrush x:Key="BgBrush"          Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
    <SolidColorBrush x:Key="SurfaceSelBrush"  Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>
    <SolidColorBrush x:Key="FgBrush"          Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>
    <SolidColorBrush x:Key="FgMutedBrush"     Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>
    <SolidColorBrush x:Key="FgVeryMutedBrush" Color="{DynamicResource {x:Static SystemColors.InactiveCaptionTextColorKey}}"/>
    <SolidColorBrush x:Key="DividerBrush"     Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>

</ResourceDictionary>
