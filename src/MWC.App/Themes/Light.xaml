<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MWC ライトテーマ。Dark.xaml と同じキー集合を明色パレットで提供する (自己完結)。
        アクセントは明背景でのコントラストを確保するため #00A6AD にやや沈める。
    -->

    <!-- 背景・サーフェス -->
    <SolidColorBrush x:Key="BgBrush"           Color="#F5F6F8"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="SurfaceSelBrush"   Color="#C9F2F4"/>

    <!-- 前景 (テキスト) -->
    <SolidColorBrush x:Key="FgBrush"           Color="#1A1D23"/>
    <SolidColorBrush x:Key="FgMutedBrush"      Color="#5C636B"/>
    <SolidColorBrush x:Key="FgVeryMutedBrush"  Color="#9AA0A8"/>
    <SolidColorBrush x:Key="DividerBrush"      Color="#D7DBE0"/>

    <!-- アクセント -->
    <SolidColorBrush x:Key="AccentBrush"       Color="#00A6AD"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#00C4CC"/>
    <SolidColorBrush x:Key="AccentTextBrush"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush"        Color="#00A6AD"/>

    <!-- セマンティック -->
    <SolidColorBrush x:Key="SuccessBrush"      Color="#107C10"/>
    <SolidColorBrush x:Key="WarnBrush"         Color="#9A7400"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerTextBrush"   Color="#FFFFFF"/>

</ResourceDictionary>
