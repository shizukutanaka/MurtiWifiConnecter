<Window x:Class="MWC.App.Views.ShortcutHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.ShortcutsTitle}" Width="500" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.ShortcutsDialogAutomation}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{x:Static r:L.ShortcutsTitle}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{x:Static r:L.ShortcutsDesc}"
                           FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="20,16">
            <ItemsControl x:Name="ShortcutGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8" Padding="14,10">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource SurfaceHoverBrush}"
                                                        CornerRadius="4" Padding="8,3"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayKey}"
                                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource FgMutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Button Content="{x:Static r:L.ActionClose}"
                    AutomationProperties.Name="{x:Static r:L.ActionClose}" IsDefault="True" IsCancel="True"
                    Click="OnClose" HorizontalAlignment="Right"
                    Padding="20,8"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </Border>
    </Grid>
</Window>
