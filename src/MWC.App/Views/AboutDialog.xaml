<Window x:Class="MWC.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.AboutTitle}" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.AboutAutomation}">
    <StackPanel Margin="28,28,28,24">

        <!-- アイコン -->
        <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- 名前 + バージョン -->
        <TextBlock Text="{x:Static r:L.AppTitle}" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{DynamicResource FgMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
        <TextBlock Text="{x:Static r:L.AboutTagline}" FontSize="12" Foreground="{DynamicResource FgVeryMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,2,0,20"/>

        <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

        <!-- 説明 -->
        <TextBlock Text="{x:Static r:L.AboutDesc}"
                   FontSize="12" Foreground="{DynamicResource FgMutedBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- リンク -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock FontSize="12">
                <Hyperlink x:Name="GitHubLink" NavigateUri="https://github.com/shizukutanaka/MurtiWifiConnecter"
                           RequestNavigate="OnHyperlinkNavigate" Foreground="{DynamicResource AccentBrush}">
                    <Run Text="{x:Static r:L.AboutGitHub}"/>
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="  ·  " Foreground="{DynamicResource FgVeryMutedBrush}" FontSize="12"/>
            <TextBlock FontSize="12">
                <Hyperlink x:Name="IssueLink" NavigateUri="https://github.com/shizukutanaka/MurtiWifiConnecter/issues"
                           RequestNavigate="OnHyperlinkNavigate" Foreground="{DynamicResource AccentBrush}">
                    <Run Text="{x:Static r:L.AboutReportBug}"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- ライセンス -->
        <TextBlock Text="{x:Static r:L.AboutLicense}"
                   FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Button Content="{x:Static r:L.ActionClose}"
                AutomationProperties.Name="{x:Static r:L.ActionClose}" IsDefault="True" IsCancel="True"
                Click="OnClose" HorizontalAlignment="Center"
                Padding="24,8" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                BorderThickness="0"/>
    </StackPanel>
</Window>
