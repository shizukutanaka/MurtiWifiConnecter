<Window x:Class="MWC.App.Views.ConnectionProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続中" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        ShowInTaskbar="False"
        AutomationProperties.Name="接続進行状況">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="SsidLabel" FontSize="17" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock x:Name="StepLabel" FontSize="13" Foreground="{DynamicResource FgMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- ステップインジケーター -->
        <ItemsControl x:Name="StepsControl" Margin="0,0,0,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- ステップアイコン -->
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2B313A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter Property="Background" Value="#00C4CC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Background" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Background" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="StepIcon" Text="●" FontSize="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                        <!-- ステップ名 -->
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter Property="Foreground" Value="#E6E8EB"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- キャンセル -->
        <Button x:Name="CancelBtn" AutomationProperties.Name="キャンセル" Content="キャンセル"
                Click="OnCancel" HorizontalAlignment="Center"
                Padding="20,8" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                BorderThickness="0"/>
    </StackPanel>
</Window>
