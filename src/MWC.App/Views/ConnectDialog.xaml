<Window x:Class="MWC.App.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.ActionConnect}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.ActionConnect}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SSID -->
        <TextBlock Grid.Row="0" x:Name="SsidLabel"
                   FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- セキュリティバッジ(技術名ではなく人間語) -->
        <TextBlock Grid.Row="1" x:Name="AuthLabel"
                   FontSize="12" Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,18"/>

        <!-- パスフレーズ -->
        <StackPanel Grid.Row="2" x:Name="PasswordPanel">
            <TextBlock Text="{x:Static r:L.LabelPassphrase}" FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,6"/>

            <!-- 入力ボックス(テキスト/パスワード切替) -->
            <Grid>
                <PasswordBox x:Name="PasswordBox"
                             Padding="10,9" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                             BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown"
                             AutomationProperties.Name="{x:Static r:L.ConnectPassphraseAutomation}"/>
                <TextBox x:Name="PasswordVisible"
                         Padding="10,9" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                         BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                         Visibility="Collapsed"
                         TextChanged="OnPasswordChanged"
                         KeyDown="OnPasswordKeyDown"
                         AutomationProperties.Name="{x:Static r:L.ConnectPassphraseVisibleAutomation}"/>
                <TextBlock x:Name="PasswordPlaceholder"
                           Text="{x:Static r:L.LabelPasswordPlaceholder}"
                           Foreground="{DynamicResource FgVeryMutedBrush}" IsHitTestVisible="False"
                           Margin="12,10,0,0" FontSize="13"/>
            </Grid>

            <!-- パスワード強度バー -->
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- トラック -->
                <Border Grid.Row="0" x:Name="StrengthBarTrack"
                        Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="2"/>
                <!-- フィル -->
                <Border Grid.Row="0" x:Name="StrengthBar" Width="0"
                        HorizontalAlignment="Left" CornerRadius="2">
                    <Border.Background>
                        <SolidColorBrush x:Name="StrengthBarBrush" Color="{DynamicResource SuccessBrush}"/>
                    </Border.Background>
                </Border>
                <!-- ラベル -->
                <TextBlock Grid.Row="1" x:Name="StrengthLabel"
                           FontSize="10" Margin="0,3,0,0"/>
            </Grid>

            <!-- 表示切替 -->
            <CheckBox x:Name="ShowPwCheck" Content="{x:Static r:L.LabelShowPassword}"
                      Margin="0,8,0,0" Foreground="{DynamicResource FgMutedBrush}" FontSize="12"
                      AutomationProperties.Name="{x:Static r:L.LabelShowPassword}"
                      Click="OnTogglePassword"/>
        </StackPanel>

        <!-- 802.1X Enterprise 入力(Enterprise 認証時のみ表示)-->
        <StackPanel Grid.Row="4" x:Name="EnterprisePanel" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock Text="{x:Static r:L.LabelEapType}" FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="EapTypeCombo"
                      Padding="8,7" Margin="0,0,0,12"
                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                      SelectionChanged="OnEapTypeChanged"
                      AutomationProperties.Name="{x:Static r:L.LabelEapType}"/>

            <TextBlock x:Name="UsernameLabel" Text="{x:Static r:L.LabelEapUsername}" FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="UsernameBox"
                     Padding="10,9" Margin="0,0,0,12"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                     KeyDown="OnPasswordKeyDown"
                     AutomationProperties.Name="{x:Static r:L.LabelEapUsername}"/>

            <TextBlock Text="{x:Static r:L.LabelEapIdentity}" FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="IdentityBox"
                     Padding="10,9"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                     KeyDown="OnPasswordKeyDown"
                     AutomationProperties.Name="{x:Static r:L.LabelEapIdentity}"/>
            <TextBlock Text="{x:Static r:L.EapHintIdentity}" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,4,0,12"/>

            <TextBlock Text="{x:Static r:L.LabelEapServerName}" FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="ServerNameBox"
                     Padding="10,9"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                     KeyDown="OnPasswordKeyDown"
                     AutomationProperties.Name="{x:Static r:L.LabelEapServerName}"/>
        </StackPanel>

        <!-- エラーメッセージ -->
        <Border Grid.Row="3" Background="{DynamicResource DangerBrush}" CornerRadius="6"
                Padding="10,8" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource DangerTextBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility,
                                     ElementName=ErrorLabel}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{x:Static r:L.ActionCancel}"
                    AutomationProperties.Name="{x:Static r:L.ActionCancel}" Click="OnCancel" IsCancel="True"
                    Padding="16,9" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
            <Button Content="{x:Static r:L.ActionConnect}"
                    AutomationProperties.Name="{x:Static r:L.ActionConnect}" Click="OnConnect" IsDefault="True"
                    Padding="20,9"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
