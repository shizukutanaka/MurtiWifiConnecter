<Window x:Class="MWC.App.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.WizardWindowTitle}" Width="480" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        ShowInTaskbar="False"
        AutomationProperties.Name="{x:Static r:L.WizardDialogAutomation}">
    <Grid>
        <!-- ページコンテナ -->
        <Grid x:Name="PageContainer"/>

        <!-- 下部ナビゲーション -->
        <Grid VerticalAlignment="Bottom" Margin="28,0,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ステップドット -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="8" Height="8"
                         Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                <Ellipse x:Name="Dot2" Width="8" Height="8"
                         Fill="{DynamicResource FgVeryMutedBrush}" Margin="0,0,6,0"/>
                <Ellipse x:Name="Dot3" Width="8" Height="8"
                         Fill="{DynamicResource FgVeryMutedBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BackBtn"
                    Content="{x:Static r:L.WizardBack}"
                    AutomationProperties.Name="{x:Static r:L.WizardBack}"
                    Click="OnBack" Visibility="Collapsed"
                    Padding="16,9" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
            <Button Grid.Column="2" x:Name="NextBtn"
                    Content="{x:Static r:L.WizardNext}"
                    AutomationProperties.Name="{x:Static r:L.WizardNext}"
                    Click="OnNext" IsDefault="True"
                    Padding="20,9"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
