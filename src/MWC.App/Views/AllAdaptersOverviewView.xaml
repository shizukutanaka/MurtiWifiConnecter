<Window x:Class="MWC.App.Views.AllAdaptersOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.AllAdaptersWindowTitle}" Width="1100" Height="640"
        MinWidth="780" MinHeight="500"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{x:Static r:L.AllAdaptersWindowAutomation}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ── ツールバー ── -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="18" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static r:L.AllAdaptersHeading}" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button AutomationProperties.Name="{x:Static r:L.AllAdaptersScanAll}" Content="{x:Static r:L.AllAdaptersScanAll}"
                            Command="{Binding LoadCommand}"
                            Padding="12,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}"
                            BorderThickness="0" FontSize="12"
                            ToolTip="{x:Static r:L.AllAdaptersScanAllTooltip}"/>
                    <Button AutomationProperties.Name="{x:Static r:L.AllAdaptersConnectAll}" Content="{x:Static r:L.AllAdaptersConnectAll}"
                            Command="{Binding ConnectAllPreferredCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                            BorderThickness="0" FontWeight="SemiBold" FontSize="12"
                            ToolTip="{x:Static r:L.AllAdaptersConnectAllTooltip}"/>
                    <Button AutomationProperties.Name="{x:Static r:L.ActionDisconnect}" Content="{x:Static r:L.ActionDisconnect}"
                            Command="{Binding DisconnectAllCommand}"
                            Padding="14,7"
                            Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                            BorderThickness="0" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 子機カード一覧 (横スクロール) ── -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Padding="16,12">
            <ItemsControl ItemsSource="{Binding Panels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- ═══ 子機カード ═══ -->
                        <Border Width="320" Margin="0,0,12,0"
                                Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- ヘッダ -->
                                    <RowDefinition Height="Auto"/>  <!-- 接続状態 -->
                                    <RowDefinition Height="*"/>     <!-- ネットワーク一覧 -->
                                    <RowDefinition Height="Auto"/>  <!-- 優先設定 -->
                                    <RowDefinition Height="Auto"/>  <!-- アクション -->
                                </Grid.RowDefinitions>

                                <!-- ヘッダ -->
                                <Grid Grid.Row="0" Margin="14,12,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="10" Foreground="{DynamicResource FgMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- スキャンインジケータ -->
                                    <TextBlock Grid.Column="1" Text="↻"
                                               Foreground="{DynamicResource AccentBrush}" FontSize="14"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsScanning}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 接続状態バー -->
                                <Border Grid.Row="1" Margin="14,0,14,10"
                                        Padding="10,8" CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#22262E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConnectedSsid,
                                                             Converter={StaticResource NullToBool}}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="#1A3D2B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9CA3AF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectedSsid,
                                                                     Converter={StaticResource NullToBool}}"
                                                                     Value="True">
                                                            <Setter Property="Fill" Value="#22C55E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusMessage}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ConnectedSignal,
                                                          StringFormat={}{0}%}"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectedSsid,
                                                                     Converter={StaticResource NullToBool}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ネットワーク一覧(検出順) -->
                                <Border Grid.Row="2" Margin="14,0,14,10"
                                        Background="{DynamicResource BgBrush}" CornerRadius="8">
                                    <ListBox ItemsSource="{Binding Networks}"
                                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="{Binding Name,
                                                StringFormat={}{0}のネットワーク}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▁"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Bars}" Value="4">
                                                                        <Setter Property="Text" Value="▄"/>
                                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Bars}" Value="3">
                                                                        <Setter Property="Text" Value="▄"/>
                                                                        <Setter Property="Foreground" Value="#A3E635"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Bars}" Value="2">
                                                                        <Setter Property="Text" Value="▃"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Ssid}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="6,0,0,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource SuccessBrush}"
                                                            CornerRadius="3" Padding="3,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓" FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- 優先ネットワーク ★ -->
                                <Expander Grid.Row="3" Margin="14,0,14,8"
                                          Foreground="{DynamicResource FgMutedBrush}">
                                    <Expander.Header>
                                        <TextBlock Text="{x:Static r:L.AllAdaptersPreferredHeader}"
                                                   FontSize="11"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding PreferredNetworks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Rank}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Ssid}"
                                                                   FontSize="11" Foreground="{DynamicResource FgBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal">
                                                            <Button AutomationProperties.Name="{x:Static r:L.AllAdaptersMoveUp}" Content="↑"
                                                                    Padding="4,0" FontSize="10"
                                                                    Command="{Binding DataContext.MoveUpPreferredCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding Ssid}"
                                                                    Background="Transparent"
                                                                    Foreground="{DynamicResource FgMutedBrush}"
                                                                    BorderThickness="0"
                                                                    ToolTip="{x:Static r:L.AllAdaptersMoveUp}"/>
                                                            <Button AutomationProperties.Name="{x:Static r:L.AllAdaptersRemovePreferred}" Content="✕"
                                                                    Padding="4,0" FontSize="10"
                                                                    Command="{Binding DataContext.RemovePreferredCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding Ssid}"
                                                                    Background="Transparent"
                                                                    Foreground="{DynamicResource DangerBrush}"
                                                                    BorderThickness="0"
                                                                    ToolTip="{x:Static r:L.AllAdaptersRemovePreferred}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button AutomationProperties.Name="{x:Static r:L.AllAdaptersAddPreferred}" Content="{x:Static r:L.AllAdaptersAddPreferred}"
                                                Command="{Binding AddPreferredCommand}"
                                                Margin="0,4,0,0" Padding="8,4"
                                                FontSize="10"
                                                Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource AccentBrush}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"/>
                                        <CheckBox Content="{x:Static r:L.AllAdaptersAutoReconnect}"
                                                  IsChecked="{Binding AutoReconnectEnabled}"
                                                  AutomationProperties.Name="{x:Static r:L.AllAdaptersAutoReconnect}"
                                                  Foreground="{DynamicResource FgMutedBrush}" FontSize="10"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- アクションボタン -->
                                <Grid Grid.Row="4" Margin="14,0,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" AutomationProperties.Name="{x:Static r:L.ActionDisconnect}" Content="{x:Static r:L.ActionDisconnect}"
                                            Command="{Binding DisconnectCommand}"
                                            Padding="10,7" Margin="0,0,6,0"
                                            Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                                            BorderThickness="0" FontSize="11"/>
                                    <Button Grid.Column="1" AutomationProperties.Name="{x:Static r:L.ActionConnect}" Content="{x:Static r:L.ActionConnect}"
                                            Click="OnConnectClickInPanel"
                                            Padding="14,7"
                                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                                            FontWeight="SemiBold" BorderThickness="0"
                                            FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── ステータスバー ── -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <TextBlock Text="{Binding SummaryStatus}" FontSize="11"
                       Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
