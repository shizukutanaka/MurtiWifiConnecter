<Window x:Class="MWC.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        xmlns:svc="clr-namespace:MWC.App.Services"
        Title="{x:Static r:L.SettingsTitle}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.SettingsDialogAutomation}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EB"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22262E"/>
            <Setter Property="Foreground" Value="#E6E8EB"/>
            <Setter Property="BorderBrush" Value="#2B313A"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1A1D23"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="{x:Static r:L.SettingsTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- ────── 表示 ────── -->
        <TextBlock Text="{x:Static r:L.SettingsSectionDisplay}" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <!-- 表示モード -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static r:L.SettingsDisplayModeLabel}"/>
                        <TextBlock Text="{x:Static r:L.SettingsDisplayModeDesc}"
                                   FontSize="11" Foreground="{DynamicResource FgMutedBrush}"/>
                    </StackPanel>
                    <!-- DisplayMode バインド: enum 直接比較 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="{x:Static r:L.SettingsModeSimple}" Margin="0,0,12,0"
                                     IsChecked="{Binding IsSimpleMode}"
                                     AutomationProperties.Name="{x:Static r:L.SettingsModeSimple}"/>
                        <RadioButton Content="{x:Static r:L.SettingsModeExpert}"
                                     IsChecked="{Binding IsExpertMode}"
                                     AutomationProperties.Name="{x:Static r:L.SettingsModeExpert}"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                <!-- テーマ -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static r:L.SettingsTheme}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              SelectedIndex="{Binding ThemeIndex}"
                              AutomationProperties.Name="{x:Static r:L.SettingsTheme}">
                        <ComboBoxItem Content="{x:Static r:L.ThemeDark}"/>
                        <ComboBoxItem Content="{x:Static r:L.ThemeLight}"/>
                        <ComboBoxItem Content="{x:Static r:L.ThemeSystem}"/>
                    </ComboBox>
                </Grid>

                <!-- 言語 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static r:L.SettingsLanguage}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Language}"
                              ItemsSource="{Binding Languages}"
                              AutomationProperties.Name="{x:Static r:L.SettingsLanguage}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ────── スキャン ────── -->
        <TextBlock Text="{x:Static r:L.SettingsSectionScan}" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static r:L.SettingsScanIntervalLabel}"/>
                        <TextBlock Text="{x:Static r:L.SettingsScanIntervalDesc}"
                                   FontSize="11" Foreground="{DynamicResource FgMutedBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Secs"
                              SelectedValue="{Binding AutoScanInterval}"
                              ItemsSource="{Binding ScanIntervals}"
                              AutomationProperties.Name="{x:Static r:L.SettingsScanIntervalLabel}"/>
                </Grid>
                <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static r:L.SettingsScanOnStartup}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding ScanOnStartup}"
                              AutomationProperties.Name="{x:Static r:L.SettingsScanOnStartup}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ────── 通知 ────── -->
        <TextBlock Text="{x:Static r:L.SettingsSectionNotify}" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static r:L.SettingsNotifyLabel}"/>
                    <TextBlock Text="{x:Static r:L.SettingsNotifyDesc}"
                               FontSize="11" Foreground="{DynamicResource FgMutedBrush}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding ShowNotifications}"
                          AutomationProperties.Name="{x:Static r:L.SettingsNotifyLabel}"/>
            </Grid>
        </Border>

        <!-- ────── 非表示ネットワーク管理 ────── -->
        <TextBlock Text="{x:Static r:L.SettingsSectionHidden}" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <!-- 空状態 (非表示ネットワークなし) -->
                <TextBlock Text="{x:Static r:L.SettingsHiddenEmpty}"
                           FontSize="12" Foreground="{DynamicResource FgMutedBrush}"
                           Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- CountToBool: true when count > 0 → collapse empty hint -->
                                <DataTrigger Binding="{Binding HiddenNetworks.Count,
                                             Converter={StaticResource CountToBool}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 一覧 -->
                <ItemsControl ItemsSource="{Binding HiddenNetworks}"
                              AutomationProperties.Name="{x:Static r:L.SettingsHiddenListAutomation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           FontSize="12"/>
                                <Button Grid.Column="1"
                                        Content="{x:Static r:L.SettingsHiddenUnhide}"
                                        AutomationProperties.Name="{x:Static r:L.SettingsHiddenUnhide}"
                                        Command="{Binding DataContext.UnhideCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4" FontSize="11"
                                        Background="{DynamicResource SurfaceHoverBrush}"
                                        Foreground="{DynamicResource FgBrush}"
                                        BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ボタン -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{x:Static r:L.ActionResetDefaults}"
                    AutomationProperties.Name="{x:Static r:L.ActionResetDefaults}"
                    Command="{Binding ResetCommand}" HorizontalAlignment="Left"
                    Padding="12,8" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                    BorderThickness="0"/>
            <Button Grid.Column="1" Content="{x:Static r:L.ActionCancel}"
                    AutomationProperties.Name="{x:Static r:L.ActionCancel}" Click="OnCancel"
                    Padding="14,8" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0"/>
            <Button Grid.Column="2" Content="{x:Static r:L.ActionSave}"
                    AutomationProperties.Name="{x:Static r:L.ActionSave}" Click="OnSave"
                    Padding="14,8" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </Grid>
    </StackPanel>
</Window>
