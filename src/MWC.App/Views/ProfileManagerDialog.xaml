<Window x:Class="MWC.App.Views.ProfileManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存済みネットワーク" Width="400" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="保存済みネットワーク管理">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="保存済みネットワーク" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                               Foreground="{DynamicResource FgMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" AutomationProperties.Name="↻" Content="↻" Click="OnRefresh"
                        Padding="10,6" Background="{DynamicResource SurfaceHoverBrush}"
                        Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- プロファイルリスト -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="保存済みプロファイル一覧"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                   FontSize="16" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Button Grid.Column="2" AutomationProperties.Name="削除" Content="削除"
                                Click="OnDeleteOne"
                                Tag="{Binding Name}"
                                Padding="8,4" FontSize="11"
                                Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource DangerBrush}"
                                BorderThickness="0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- フッタ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center"
                           Text="削除したプロファイルは元に戻せません"/>
                <Button Grid.Column="1" AutomationProperties.Name="閉じる" Content="閉じる" IsCancel="True"
                        Click="OnClose" Padding="16,8"
                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}"
                        BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
