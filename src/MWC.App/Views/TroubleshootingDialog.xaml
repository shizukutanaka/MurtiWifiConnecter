<Window x:Class="MWC.App.Views.TroubleshootingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続の問題" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="接続トラブルシューティング">
    <StackPanel Margin="24,20">

        <!-- アイコン + タイトル -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="IconLabel" FontSize="28" Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="SsidLabel" FontSize="12" Foreground="{DynamicResource FgMutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- 原因 -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <TextBlock x:Name="ReasonLabel" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource FgMutedBrush}"/>
        </Border>

        <!-- 解決手順 -->
        <TextBlock Text="解決方法" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource FgMutedBrush}" Margin="0,0,0,8"/>
        <ItemsControl x:Name="StepsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="•" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Top" FontSize="14" Margin="0,-1,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                   FontSize="13" Margin="4,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ボタン -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button AutomationProperties.Name="再試行" Content="再試行" x:Name="RetryBtn"
                    Click="OnRetry" IsDefault="True"
                    Padding="16,9" Margin="0,0,8,0"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
            <Button AutomationProperties.Name="閉じる" Content="閉じる" Click="OnClose" IsCancel="True"
                    Padding="16,9"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
