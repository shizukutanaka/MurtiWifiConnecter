<Window x:Class="MWC.App.Views.QrCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.QRWindowTitle}" Width="380" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.QRDialogAutomation}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SsidLabel"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8"
                Padding="16" Margin="10">
            <Image x:Name="QrImage" Stretch="Uniform"/>
        </Border>

        <TextBlock Grid.Row="2" x:Name="UriLabel"
                   FontFamily="Consolas, Cascadia Mono, monospace"
                   TextWrapping="Wrap" Foreground="{DynamicResource FgMutedBrush}" FontSize="11"
                   Margin="0,8,0,0" TextAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="{x:Static r:L.ActionCopy}"
                    AutomationProperties.Name="{x:Static r:L.ActionCopy}" Click="OnCopy" MinWidth="90" Margin="0,0,8,0"
                    Padding="12,8" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0"/>
            <Button Content="{x:Static r:L.QRSavePng}"
                    AutomationProperties.Name="{x:Static r:L.QRSavePng}" Click="OnSave" MinWidth="90" Margin="0,0,8,0"
                    Padding="12,8" Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}" BorderThickness="0"/>
            <Button Content="{x:Static r:L.ActionClose}"
                    AutomationProperties.Name="{x:Static r:L.ActionClose}" Click="OnClose" MinWidth="90" IsCancel="True"
                    Padding="12,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
