<Window x:Class="MWC.App.Views.CaptivePortalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="サインインが必要です" Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="キャプティブポータル認証">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- ヘッダ -->
            <RowDefinition Height="*"/>     <!-- ブラウザ -->
            <RowDefinition Height="Auto"/>  <!-- フッタ -->
        </Grid.RowDefinitions>

        <!-- ヘッダ (Apple Safari の外観に近い) -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="サインインが必要です" FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SsidLabel" FontSize="11"
                                   Foreground="{DynamicResource FgMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- URL バー (読み取り専用) -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6"
                        Margin="12,0" Padding="10,5">
                    <TextBlock x:Name="UrlLabel" FontSize="11"
                               Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Grid.Column="2" AutomationProperties.Name="外部ブラウザで開く" Content="外部ブラウザで開く"
                        Click="OnOpenExternal" Padding="10,6"
                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                        BorderThickness="0" FontSize="11"/>
            </Grid>
        </Border>

        <!-- WebBrowser -->
        <WebBrowser Grid.Row="1" x:Name="Browser"
                    Navigating="OnNavigating"
                    LoadCompleted="OnLoaded"/>

        <!-- フッタ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusLabel"
                           Text="読み込み中…" FontSize="11"
                           Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center"/>

                <Button Grid.Column="1" AutomationProperties.Name="スキップ" Content="スキップ"
                        Click="OnSkip" Padding="12,7" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                        BorderThickness="0"/>
                <Button Grid.Column="2" AutomationProperties.Name="接続完了" Content="接続完了"
                        Click="OnDone" Padding="14,7" IsDefault="True"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        FontWeight="SemiBold" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
