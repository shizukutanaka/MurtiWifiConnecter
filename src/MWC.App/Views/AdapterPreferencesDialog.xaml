<Window x:Class="MWC.App.Views.AdapterPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.AdapterDialogTitle}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.AdapterDialogAutomation}">
    <StackPanel Margin="24,22">

        <!-- ヘッダ -->
        <StackPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="📶" FontSize="22" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AdapterNameLabel" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="AdapterDescLabel" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ── 表示名 ────────────────────────────── -->
        <TextBlock Text="{x:Static r:L.AdapterDisplayNameSection}" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBox x:Name="LabelBox" Padding="10,8"
                         Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}"
                         BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                         AutomationProperties.Name="{x:Static r:L.AdapterDisplayNameSection}"/>
                <TextBlock Text="{x:Static r:L.AdapterDisplayNameHint}"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── バンド設定 ──────────────────────────── -->
        <TextBlock Text="{x:Static r:L.AdapterBandSection}" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <RadioButton x:Name="BandAny" Content="{x:Static r:L.BandAny}" GroupName="band"
                             AutomationProperties.Name="{x:Static r:L.BandAny}"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band24" Content="{x:Static r:L.AdapterBand24}" GroupName="band"
                             AutomationProperties.Name="{x:Static r:L.AdapterBand24}"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band5"  Content="{x:Static r:L.AdapterBand5}" GroupName="band"
                             AutomationProperties.Name="{x:Static r:L.AdapterBand5}"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band6"  Content="{x:Static r:L.AdapterBand6E}" GroupName="band"
                             AutomationProperties.Name="{x:Static r:L.AdapterBand6E}"
                             Foreground="{DynamicResource FgBrush}"/>
                <TextBlock Text="{x:Static r:L.AdapterBandDesc}"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── ピン留めSSID ────────────────────────── -->
        <TextBlock Text="{x:Static r:L.AdapterPinnedSection}" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <ListBox x:Name="PinnedList" MaxHeight="120"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="★"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="2"
                                        AutomationProperties.Name="{x:Static r:L.AdapterPinnedUnpin}"
                                        Content="✕"
                                        Click="OnUnpin" Tag="{Binding}"
                                        Padding="6,2" FontSize="10"
                                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                                        BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="{x:Static r:L.AdapterPinnedEmpty}"
                           FontSize="11" Foreground="{DynamicResource FgVeryMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8"/>
                <TextBlock Text="{x:Static r:L.AdapterAutoJoinDesc}"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 子機の有効化 ────────────────────────── -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static r:L.AdapterEnabledLabel}"/>
                    <TextBlock Text="{x:Static r:L.AdapterEnabledDesc}"
                               FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="EnabledCheck"
                          IsChecked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Static r:L.AdapterEnabledLabel}"/>
            </Grid>
        </Border>

        <!-- ── ボタン ─────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static r:L.ActionCancel}"
                    AutomationProperties.Name="{x:Static r:L.ActionCancel}" IsCancel="True" Click="OnCancel"
                    Padding="16,8" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
            <Button Content="{x:Static r:L.ActionSave}"
                    AutomationProperties.Name="{x:Static r:L.ActionSave}" IsDefault="True" Click="OnSave"
                    Padding="20,8"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
