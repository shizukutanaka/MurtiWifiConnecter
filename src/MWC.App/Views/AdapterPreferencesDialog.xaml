<Window x:Class="MWC.App.Views.AdapterPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="子機の設定" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="無線アダプター設定">
    <StackPanel Margin="24,22">

        <!-- ヘッダ -->
        <StackPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="📶" FontSize="22" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AdapterNameLabel" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="AdapterDescLabel" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ── 表示名 ────────────────────────────── -->
        <TextBlock Text="表示名" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBox x:Name="LabelBox" Padding="10,8"
                         Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgBrush}"
                         BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                         AutomationProperties.Name="アダプター表示名"/>
                <TextBlock Text="例: 自宅用ドングル / モバイル用 / 5GHz専用"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── バンド設定 ──────────────────────────── -->
        <TextBlock Text="使用バンド" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <RadioButton x:Name="BandAny" Content="すべてのバンド" GroupName="band"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band24" Content="2.4 GHz のみ" GroupName="band"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band5"  Content="5 GHz のみ" GroupName="band"
                             Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
                <RadioButton x:Name="Band6"  Content="6 GHz のみ (Wi-Fi 6E/7)" GroupName="band"
                             Foreground="{DynamicResource FgBrush}"/>
                <TextBlock Text="この子機で表示・接続できるバンドを制限"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── ピン留めSSID ────────────────────────── -->
        <TextBlock Text="優先SSID(自動接続候補)" FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                   Margin="0,0,0,6" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <ListBox x:Name="PinnedList" MaxHeight="120"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="★"
                                           Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="2" AutomationProperties.Name="✕" Content="✕"
                                        Click="OnUnpin" Tag="{Binding}"
                                        Padding="6,2" FontSize="10"
                                        Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}"
                                        BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="ピン留めされたSSIDはありません"
                           FontSize="11" Foreground="{DynamicResource FgVeryMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8"/>
                <TextBlock Text="Auto-Joinはこの順位で自動接続を試みます"
                           FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── 子機の有効化 ────────────────────────── -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="この子機を使用"/>
                    <TextBlock Text="無効にすると一覧から非表示になります"
                               FontSize="10" Foreground="{DynamicResource FgVeryMutedBrush}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="EnabledCheck"
                          IsChecked="True" VerticalAlignment="Center"
                          AutomationProperties.Name="子機を使用する"/>
            </Grid>
        </Border>

        <!-- ── ボタン ─────────────────────────────── -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.Name="キャンセル" Content="キャンセル" IsCancel="True" Click="OnCancel"
                    Padding="16,8" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="{DynamicResource FgMutedBrush}" BorderThickness="0"/>
            <Button AutomationProperties.Name="保存" Content="保存" IsDefault="True" Click="OnSave"
                    Padding="20,8"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
