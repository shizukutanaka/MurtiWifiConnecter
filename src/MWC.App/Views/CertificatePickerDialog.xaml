<Window x:Class="MWC.App.Views.CertificatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:MWC.App.Resources"
        Title="{x:Static r:L.CertPickerTitle}"
        Width="580" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        AutomationProperties.Name="{x:Static r:L.CertPickerAutomation}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{x:Static r:L.CertPickerTitle}" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="{x:Static r:L.CertPickerDesc}"
                           FontSize="11" Foreground="{DynamicResource FgMutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 証明書リスト -->
        <ListBox Grid.Row="1" x:Name="CertList"
                 Margin="16" BorderThickness="1"
                 BorderBrush="{DynamicResource DividerBrush}"
                 Background="{DynamicResource SurfaceBrush}"
                 SelectionChanged="OnSelectionChanged"
                 AutomationProperties.Name="{x:Static r:L.CertListAutomation}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 有効期限インジケーター -->
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                Background="{Binding ExpiryColor}"
                                VerticalAlignment="Center">
                            <TextBlock Text="🔐" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="14"/>
                        </Border>

                        <!-- 証明書情報 -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Issuer}"
                                       FontSize="10"
                                       Foreground="{DynamicResource FgMutedBrush}"/>
                            <TextBlock Text="{Binding ExpiryLabel}"
                                       FontSize="10"
                                       Foreground="{Binding ExpiryColor}"/>
                        </StackPanel>

                        <!-- サムプリント -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ThumbprintShort}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="9"
                                   Foreground="{DynamicResource FgMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 詳細パネル -->
        <Border Grid.Row="2" x:Name="DetailPanel" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1"
                Padding="20,12" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static r:L.CertSubject}" Foreground="{DynamicResource FgMutedBrush}" FontSize="11"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SubjectLabel" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static r:L.CertIssuerLabel}" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="IssuerLabel" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static r:L.CertExpiryLabel}" Foreground="{DynamicResource FgMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExpiryDetailLabel" FontSize="11" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- ボタン行 -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="{x:Static r:L.CertOpenStore}"
                        AutomationProperties.Name="{x:Static r:L.CertOpenStore}"
                        Click="OnOpenStore" Padding="12,7"
                        Background="{DynamicResource SurfaceHoverBrush}"
                        BorderThickness="0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static r:L.ActionCancel}"
                            AutomationProperties.Name="{x:Static r:L.ActionCancel}" IsCancel="True" Click="OnCancel"
                            Padding="16,7" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceHoverBrush}"
                            BorderThickness="0"/>
                    <Button x:Name="OkButton"
                            Content="{x:Static r:L.CertUseThis}"
                            AutomationProperties.Name="{x:Static r:L.CertUseThis}"
                            IsDefault="True" Click="OnOk" IsEnabled="False"
                            Padding="16,7"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            FontWeight="SemiBold" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
