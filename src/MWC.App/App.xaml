<Application x:Class="MWC.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MWC.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MWC.App;component/Themes/Generic.xaml"/>
                <ResourceDictionary Source="/MWC.App;component/Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Converters (全Window共有) ── -->
            <conv:NullToBoolConverter        x:Key="NullToBool"/>
            <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter  x:Key="InvBoolToVis" Invert="True"/>
            <conv:NullToVisibilityConverter  x:Key="NullToVis"/>
            <conv:NullToVisibilityConverter  x:Key="InvNullToVis" Invert="True"/>
            <conv:CountToBoolConverter       x:Key="CountToBool"/>
            <conv:ZeroToVisibleConverter     x:Key="ZeroToVis"/>
            <conv:StringToVisibilityConverter   x:Key="StrToVis"/>

            <!-- フォントフォールバック (全言語対応) -->
            <FontFamily x:Key="FontFamilyDefault">
                Segoe UI Variable, Segoe UI, Yu Gothic UI, Meiryo UI, MS Gothic, Arial, sans-serif
            </FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
