<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net9.0 専用。コードベースは net6+ API (Math.Clamp / ArgumentNullException.ThrowIfNull /
         Random.Shared / .ToHashSet() 等) を全面的に使用しており netstandard2.0 では
         ビルド不能(これらは ns2.0 に存在せずポリフィル不可)。実消費者(各 Platform プロジェクト)
         も net9.0 のため、誤った ns2.0 互換主張を取り下げ net9.0 単一ターゲットに統一。 -->
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MWC.Core</RootNamespace>
    <AssemblyName>MWC.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet メタ (MWC.SDK と共通) -->
    <PackageId>MWC.Core</PackageId>
    <Version>3.11.0</Version>
    <Authors>ShizukuTanaka</Authors>
    <Description>MWC Core — Wi-Fi management models and services. Minimal dependencies. Targets net9.0.</Description>
    <PackageTags>wifi;wpa3;eap;net9</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/shizukutanaka/MurtiWifiConnecter</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- LoggerMessage source generation 用 (高性能構造化ログ)。バージョンは Directory.Packages.props で集中管理 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
    <!-- GroupPolicyProvider が Registry を使用。plain net9.0 では in-box でないため明示参照 -->
    <PackageReference Include="Microsoft.Win32.Registry" />
  </ItemGroup>
</Project>

