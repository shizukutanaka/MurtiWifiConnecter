<Window x:Class="MurtiWifiConnecter.QuickSetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFiコネクター - 初期設定" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        
        <Style x:Key="WizardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="個人・家庭向けWiFi設定" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="簡単3ステップで使い始められます" FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StepIndicator" Text="ステップ 1/3" FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="ProgressBar" Width="120" Height="4" 
                                 Background="#E0E0E0" Foreground="{StaticResource PrimaryBrush}" 
                                 Value="33" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource SurfaceBrush}" Margin="32"
                    CornerRadius="12" Padding="32">
                <Grid>
                    <!-- ステップ1: ユーザー情報 -->
                    <StackPanel x:Name="Step1Panel">
                    <TextBlock Text="ユーザー情報" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="お名前またはユーザー名" FontSize="14" FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="UserNameTextBox" FontSize="14" Padding="12,10" Height="40"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="家族で使用する場合は「お父さん」「お母さん」など" FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="使用形態" FontSize="14" FontWeight="Medium" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton x:Name="HomeUseRadio" Content="個人・家庭利用（通常モード）" 
                                     FontSize="14" Margin="0,0,0,8" IsChecked="True"/>
                        <RadioButton x:Name="FamilyUseRadio" Content="家族利用（複数ユーザー）" 
                                     FontSize="14" Margin="0,0,0,8"/>
                        <RadioButton x:Name="ChildModeRadio" Content="お子様利用（安全制限モード）" 
                                     FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <!-- ステップ2: ネットワーク設定 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="家庭内ネットワーク設定" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    
                    <TextBlock Text="よく使用する家庭内のWiFiネットワークを登録してください（オプション）" 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,0,0,24" TextWrapping="Wrap"/>
                    
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ネットワーク名（SSID）" FontSize="14" FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="HomeNetworkSSID" FontSize="14" Padding="12,10" Height="40"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="表示名（わかりやすい名前）" FontSize="14" FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="HomeNetworkName" FontSize="14" Padding="12,10" Height="40"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="例：「リビングのWiFi」「我が家のネット」など" FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ステップ3: 完了確認 -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="設定完了" FontSize="20" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    
                    <Border Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="設定内容の確認" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ユーザー名：" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ConfirmUserName" Grid.Row="0" Grid.Column="1" FontSize="14" 
                                           FontWeight="Medium" Margin="0,0,0,8"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="使用形態：" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ConfirmMode" Grid.Row="1" Grid.Column="1" FontSize="14" 
                                           FontWeight="Medium" Margin="0,0,0,8"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="家庭ネット：" FontSize="14"/>
                                <TextBlock x:Name="ConfirmNetwork" Grid.Row="2" Grid.Column="1" FontSize="14" 
                                           FontWeight="Medium"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🔋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="バッテリー最適化が自動的に有効になります" FontSize="14" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ローディング表示 -->
                <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" 
                                 Background="#E0E0E0" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock x:Name="StatusText" Text="設定を適用しています..." FontSize="14" 
                               HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- ボタン -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BackButton" Grid.Column="0" Content="戻る" 
                        Style="{StaticResource WizardButtonStyle}" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="{StaticResource PrimaryBrush}" 
                        BorderThickness="1" BorderBrush="{StaticResource PrimaryBrush}"
                        Click="BackButton_Click" IsEnabled="False"/>
                
                <Button x:Name="NextButton" Grid.Column="1" Content="次へ" 
                        Style="{StaticResource WizardButtonStyle}"
                        Click="NextButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>