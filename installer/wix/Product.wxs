<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName="MWC" ?>
  <?define Manufacturer="Shizuku Tanaka" ?>
  <?define UpgradeCode="A6D8F4E2-7C1B-4F9D-8E3A-2B5F6C7D8E9F" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="MWC - Multi-adapter Wi-Fi tool" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Launch conditions -->
    <Launch Condition="Installed OR (VersionNT &gt;= 603)"
            Message="Windows 10 (1809) or later required." />
    <Launch Condition="Installed OR Privileged"
            Message="Administrator rights required." />

    <!-- Properties -->
    <Property Id="ARPPRODUCTICON" Value="WifixIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/shizukutanaka/MurtiWifiConnecter" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/shizukutanaka/MurtiWifiConnecter" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Icon Id="WifixIcon" SourceFile="$(AppPath)\MWC.exe" />

    <!-- Directory layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Components -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- 収録ファイルは明示的に列挙する (WiX v4 で書ける形)。
           ⚠ 経緯 (2026-09 実測 → 2026-11 修理): 当初ここは
           `<Files Include="$(AppPath)\**" />` というワイルドカードハーベスト
           だったが、それは WiX **v5 以降**の機能。github.com/wixtoolset/wix の
           実ソースを v4.0.0〜v4.0.6 (v4.x の全パッチ) と v5.0.0 で突き合わせた
           ところ、このハーベスト用パーサ (テストスイート "HarvestFiles" 一式
           含む) は v5.0.0 にのみ存在し、v4.x のどのバージョンにも存在しな
           かった。xmlns の URI が "v4/wxs" なのはスキーマ世代の命名であり、
           ツールセットのバージョンとは無関係 (v5.0.0 のテスト .wxs も同じ
           xmlns を使っている) —— これに惑わされて「v4 対応」と誤認しないこと。
           docs/adr/0005-multi-channel-distribution.md が決定したのは「WiX v4」
           なので、v5 へ上げるのではなく、この要素を v4 で使える明示列挙へ
           置き換えた。
           収録対象が MWC.exe 1 つだけで済むのは、MWC.App が
           PublishSingleFile=true で publish されるため (実測: win-x64 の
           publish 出力は MWC.exe のほか .pdb と .xml のビルド成果物のみで、
           実行に要るのは MWC.exe だけ)。
           ⚠ PublishSingleFile を無効化したり自己完結化したりしたら、publish
           出力のファイルが増える。そのときはこの列挙へ File を足すこと。
           足し忘れてもビルドは成功してしまう (MSI に黙って入らない) ので、
           publish 設定を変えたら出力とこの一覧を必ず突き合わせること。
           逆に、列挙したファイルが無ければ wix build はエラーで落ちる。 -->
      <Component Id="MainExecutable" Guid="*">
        <File Id="MWC.exe" Source="$(AppPath)\MWC.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartMenuMWC"
                Name="MWC"
                Description="Multi-adapter Wi-Fi tool"
                Target="[INSTALLFOLDER]MWC.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="WifixIcon" />
      <RemoveFolder Id="CleanupShortcutFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)\$(ProductName)"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopMWC"
                Name="MWC"
                Target="[INSTALLFOLDER]MWC.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="WifixIcon" />
      <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)\$(ProductName)"
                     Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- PATH 追加(CLI 用) -->
    <Component Id="PathEnv" Directory="INSTALLFOLDER" Guid="*">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no"
                   Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="Software\$(Manufacturer)\$(ProductName)"
                     Name="path_added" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="MWC" Level="1" Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="PathEnv" />
      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Custom action: 起動オプション -->
    <Property Id="LAUNCHWIFIX" Value="1" />
    <CustomAction Id="LaunchApp"
                  FileRef="MWC.exe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize"
              Condition="NOT Installed AND LAUNCHWIFIX=1" />
    </InstallExecuteSequence>
  </Package>
</Wix>
