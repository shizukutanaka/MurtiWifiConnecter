<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Repo metadata -->
    <Authors>Shizuku Tanaka</Authors>
    <Company>MWC</Company>
    <Copyright>© 2026 Shizuku Tanaka</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/shizukutanaka/MurtiWifiConnecter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>3.12.0</Version>
    <AssemblyVersion>3.12.0.0</AssemblyVersion>
    <FileVersion>3.12.0.0</FileVersion>

    <!-- 出力統一 -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
      <!-- 依存関係ロック: CI での再現性保証 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- locked mode はオプトイン (MWC_LOCKED_RESTORE=true)。
         packages.lock.json をコミットしていない状態で GITHUB_ACTIONS に
         強制すると restore が失敗するため、明示フラグでのみ有効化する。 -->
    <RestoreLockedMode Condition="'$(MWC_LOCKED_RESTORE)' == 'true'">true</RestoreLockedMode>
    <!-- SBOM (Software Bill of Materials) 生成 -->
    <GenerateSBOM>true</GenerateSBOM>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version はここに書けない。Directory.Packages.props で中央管理しているため
         (ManagePackageVersionsCentrally=true)、インラインの Version は NU1008 エラーになり
         **全プロジェクトの restore が失敗する**。バージョンは PackageVersion 項目で指定する。 -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"
                      Condition="'$(IsTestProject)' != 'true'" />
  </ItemGroup>
</Project>
